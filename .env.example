# Copy this file to .env and fill the values; .env is ignored by Git
DEBUG=1
SECRET_KEY=REPLACE_WITH_GENERATED_50_PLUS_CHARACTER_RANDOM_VALUE
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=my_vahta
DB_USER=my_vahta
DB_PASSWORD=CHANGE_ME_LOCALLY
DB_HOST=127.0.0.1
DB_PORT=5432
# For Django CI test runner only: explicit MV_TEST_SQLITE=1 skips PostgreSQL.
# Never use SQLite for the actual local application or VPS.
